# Resend Email Integration (https://resend.com)
# Obtain an API key from your Resend Dashboard (e.g. re_123456789...)
RESEND_API_KEY=

# Verified sender address configured in Resend (default: onboarding@resend.dev)
RESEND_FROM_EMAIL="Chinmaya Vidyalaya Tarapur <onboarding@resend.dev>"

# Destination email for admission and contact inquiries (stays server-side only)
ADMISSION_EMAIL="cvtarapur@chinmayamission.com"
CONTACT_EMAIL="cvtarapur@chinmayamission.com"

# Express Server Port (default: 5000)
PORT=5000
