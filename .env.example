# ==============================================================================
# Chinmaya Vidyalaya Tarapur - Environment Configuration
# ==============================================================================

# Option 1: Direct SMTP / Gmail Integration (Recommended for direct inbox delivery)
# For Gmail: Use your Gmail address and a 16-character Google App Password (not your normal password)
# To create App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Chinmaya Vidyalaya Tarapur <your_email@gmail.com>"

# Option 2: Resend Email Integration (https://resend.com)
# Obtain an API key from your Resend Dashboard (e.g. re_123456789...)
# Note: Free Resend keys with onboarding@resend.dev can only send to your account email unless domain is verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Chinmaya Vidyalaya Tarapur <onboarding@resend.dev>"

# Destination Email Addresses (Department Specific)
ADMISSION_EMAIL="cv.info@chinmayamission.com"
ALUMNI_EMAIL="cv.info@chinmayamission.com"
CAREERS_EMAIL="cv.info@chinmayamission.com"
CONTACT_EMAIL="cv.info@chinmayamission.com"
PRINCIPAL_EMAIL="cv.principal@chinmayamission.com"

# Express Server Port (default: 5000)
PORT=5000
